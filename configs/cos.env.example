# Copy outside Git (e.g. configs/cos.env), replace placeholders, then source it.
# Leave disabled until the private bucket, CAM, CORS and lifecycle are configured.
export LCF_COS_ENABLED=false
export LCF_COS_BUCKET_URL='https://BUCKET-APPID.cos.REGION.myqcloud.com'
export LCF_COS_PREFIX='lucky/direct'
export LCF_COS_SECRET_ID='SECRET_ID'
export LCF_COS_SECRET_KEY='SECRET_KEY'
# Optional STS credentials: renew/restart BOTH API and worker before expiry.
export LCF_COS_SESSION_TOKEN=''
export LCF_DIRECT_UPLOAD_MAX_BYTES=134217728
